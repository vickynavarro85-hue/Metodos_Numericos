  ### B. Método Manual desde Código MATLAB:

  Cualquier corrida puede repetirse ejecutando:

    % 1. Cargar la configuracion archivada
    cfg = jsondecode(fileread('results/RUN-32-RK4-15/config.json'));
    
    % 2. Cargar parametros inmutables y el modelo
    params = get_params();
    f = @(t, T) model(t, T, params);

    % 3. Integrar segun el metodo guardado en cfg
    if strcmp(cfg.solver, 'rk4')
        [t, y, nfev] = solve_rk4(f, [cfg.t0, cfg.tf], cfg.T0, cfg.h);
    elseif strcmp(cfg.solver, 'ode45')
        [t, y, nfev] = solve_adaptive('ode45', f, [cfg.t0, cfg.tf], cfg.T0, cfg.rtol, cfg.atol);
    end

    % 4. Comprobar contra los datos originales
    saved = load('results/RUN-32-RK4-15/solution.mat');
    max_diff = max(abs(y(:) - saved.T_K(:)));
    fprintf('Discrepancia maxima: %.4e K\n', max_diff); % Arroja 0.0000e+00 K
